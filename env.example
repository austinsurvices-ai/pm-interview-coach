# Copy this file, name the copy ".env", and fill it in.

# Which AI to use: ollama (free, on your computer), gemini (free tier), or anthropic (paid)
PROVIDER=ollama

# Optional: override the model. Leave blank for the default.
# Ollama default: llama3.1:8b   (on an older laptop try: llama3.2:3b)
# Gemini default: gemini-3.8-flash
MODEL=

# Only needed for PROVIDER=gemini. Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed for PROVIDER=anthropic.
ANTHROPIC_API_KEY=
